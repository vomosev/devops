# ---------------------------------------------------------------------------
# DevOps Academy — example environment file
#
# Copy this file to `.env` and replace the placeholder values.
#   cp .env.example .env
#
# NEVER commit your real `.env` file — it is ignored via .gitignore.
# ---------------------------------------------------------------------------

# ----------------------------- Server runtime ------------------------------

# Port the Express API binds to (assigned by the deploy script).
PORT=4115

# Node environment: development | production
NODE_ENV=production

# ------------------------------- Database ----------------------------------

# MySQL host (hostname or IP).
DB_HOST=localhost

# MySQL user with SELECT/INSERT/UPDATE/DELETE rights on DB_NAME.
DB_USER=devops_user

# MySQL password — replace with your own value.
DB_PASSWORD=replace_with_db_password

# MySQL database name (create it, then apply schema.sql).
DB_NAME=devops

# -------------------------------- Sessions ---------------------------------

# Secret used to sign the express-session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_session_secret

# ---------------------------------- TLS ------------------------------------

# When 'true' the API terminates TLS itself using the certificate paths below.
# Set to 'false' to run a plain HTTP server (local development only).
SSL_ENABLED=true

# Absolute path to the TLS certificate.
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt

# Absolute path to the TLS private key.
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key

# Optional absolute path to a CA chain file (leave blank if not required).
SSL_CA_PATH=

# --------------------------- CORS / client origin --------------------------

# Primary allowed browser origin for CORS and cookie settings.
CLIENT_ORIGIN=https://devops.arx-app.com

# ------------------------------- Frontend ----------------------------------

# Base URL the browser uses to reach the API (baked in at build time).
NEXT_PUBLIC_API_BASE_URL=https://devops-api.arx-app.com:4115